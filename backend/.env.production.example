# RepoGuard production/testnet environment contract.
# Never commit real secret values.

# -----------------------------------------------------------------------------
# Hardened public-preview launch profile
# -----------------------------------------------------------------------------
# Secure launch default: public repositories only. Optional provider credentials
# are deliberately suppressed while this flag is enabled so a service-level
# token cannot silently turn a public scan into private-repository access.
REPOGUARD_PUBLIC_PREVIEW_ONLY=1

# Self-hosted Gitea/Gogs/OneDev clone URLs are disabled by default because they
# expand the outbound-network/SSRF trust boundary. Enable only in a controlled
# environment after the target host is explicitly reviewed.
REPOGUARD_ALLOW_SELF_HOSTED_PROVIDERS=0

# Browser CORS is closed unless approved origins are supplied as a comma-
# separated list. Machine-to-machine API clients do not need wildcard CORS.
REPOGUARD_CORS_ORIGINS=

# Request/resource abuse controls.
REPOGUARD_MAX_REQUEST_BYTES=65536
REPOGUARD_MAX_CONCURRENT_SCANS=4

# -----------------------------------------------------------------------------
# Repository provider credentials
# -----------------------------------------------------------------------------
# During the public-preview launch, leave optional provider credentials unset
# unless required for controlled staging. Private/authenticated repository
# access is outside the initial launch scope until tenant authorization and
# isolation are verified.

# GitHub
GITHUB_PERSONAL_ACCESS_TOKEN=
# Alternatives supported by the adapter: GITHUB_TOKEN or GH_TOKEN

# GitLab
REPOGUARD_GITLAB_TOKEN=
# Alternative supported: GITLAB_TOKEN

# Bitbucket
REPOGUARD_BITBUCKET_USERNAME=
REPOGUARD_BITBUCKET_APP_PASSWORD=
# Alternative secret supported: REPOGUARD_BITBUCKET_TOKEN

# Azure DevOps
REPOGUARD_AZURE_DEVOPS_PAT=

# Gitea / Gogs / Codeberg / OneDev
REPOGUARD_GITEA_USERNAME=
REPOGUARD_GITEA_TOKEN=
REPOGUARD_GOGS_USERNAME=
REPOGUARD_GOGS_TOKEN=
REPOGUARD_CODEBERG_USERNAME=
REPOGUARD_CODEBERG_TOKEN=
REPOGUARD_ONEDEV_USERNAME=
REPOGUARD_ONEDEV_TOKEN=

# SourceHut
REPOGUARD_SOURCEHUT_TOKEN=

# AWS CodeCommit (required for CodeCommit scans; disabled by public-preview mode)
REPOGUARD_AWS_CODECOMMIT_USERNAME=
REPOGUARD_AWS_CODECOMMIT_PASSWORD=

# Google Cloud Source Repositories (required for authenticated scans; disabled by
# public-preview mode). Compatibility is maintained for existing repositories.
REPOGUARD_GCP_OAUTH_TOKEN=

# Persistent state. Mount a host volume at /data before using these paths.
REPOGUARD_CACHE_DB=/data/repoguard-cache.sqlite3
REPOGUARD_TELEMETRY_DB=/data/repoguard-commerce.sqlite3
REPOGUARD_CACHE_TTL_SECONDS=86400
REPOGUARD_SCANNER_VERSION=1.0.0
REPOGUARD_RULESET_VERSION=1.0.0

# x402 Base Sepolia acceptance stage.
REPOGUARD_X402_ENABLED=1
REPOGUARD_PAY_TO=0xYOUR_PUBLIC_RECEIVER_ADDRESS
REPOGUARD_X402_NETWORK=eip155:84532
REPOGUARD_X402_FACILITATOR_URL=https://x402.org/facilitator

# Product prices are defined in backend/product_catalog.py, not in secrets.

# Mainnet stays blocked until testnet settlement + discovery acceptance evidence.
REPOGUARD_X402_ALLOW_MAINNET=0
